# Settings for the production stack (compose.yaml). Copy to .env on the server and fill in.
# Never commit the real file.

# --- Site ---
# Before the domain points here: SITE_ADDRESS=:80 and PUBLIC_URL=http://<elastic-ip>, COOKIE_SECURE=false
# With the domain: SITE_ADDRESS=gmclanka.lk, www.gmclanka.lk   PUBLIC_URL=https://gmclanka.lk
SITE_ADDRESS=:80
PUBLIC_URL=http://203.0.113.10
COOKIE_SECURE=false
# Image tag CI deploys: latest (production) or staging
IMAGE_TAG=latest

# --- Database ---
# Only applied when the database volume is first created; an existing volume keeps its old password
MYSQL_ROOT_PASSWORD=change-me

# --- Security ---
# openssl rand -base64 48
JWT_SECRET=change-me
JPA_SHOW_SQL=false

# --- Email (leave SPRING_MAIL_HOST commented out to log emails instead of sending them) ---
# SPRING_MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app-password
MAIL_FROM=you@example.com

# --- Stripe (empty = card payments hidden) ---
# Webhook endpoint to register in the Stripe dashboard: <PUBLIC_URL>/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
